# Google Cloud project ID (required)
GCP_PROJECT_ID=

# Log name in Google Cloud Logging (required)
# Logs appear under: logName="projects/<GCP_PROJECT_ID>/logs/<LOG_NAME>"
LOG_NAME=vercel-logs

# Vercel webhook secret for HMAC signature verification (optional)
# Generate with: openssl rand -hex 32
# Must match the secret configured in Vercel Log Drain settings
VERCEL_WEBHOOK_SECRET=
